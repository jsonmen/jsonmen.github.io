---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets'; // Add this import!
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 2);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
                                <h1>Здоров! I'm <span class="highlight">jsonmen</span></h1>
                                <p>
                                        I'm a developer, content creator, and sometimes an electrician. I have an obsession with optimizing things. Physics is kinda cool tho.
                                        <br />
                                        <span class="footnote">*I use NixOS btw</span>
                                </p>
                        </section>

			<hr />

			<section class="recent-posts">
                            <h2>Recent Writing</h2>
                            <div class="post-grid">
                                    {posts.map((post) => (
                                            <a href={`/blog/${post.id}/`} class="post-card">
                                                    <div class="image-wrapper">
                                                            {post.data.heroImage && (
                                                                    <Image 
                                                                            src={post.data.heroImage} 
                                                                            alt={`Cover image for ${post.data.title}`} 
                                                                            width={720} 
                                                                            height={360}
                                                                            loading="lazy"
                                                                    />
                                                            )}
                                                    </div>
                                                    <div class="card-content">
                                                            <h3 class="post-title">{post.data.title}</h3>
                                                            <span class="post-date">
                                                                    {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                                                                            year: 'numeric',
                                                                            month: 'short',
                                                                            day: 'numeric'
                                                                    })}
                                                            </span>
                                                    </div>
                                            </a>
                                    ))}
                            </div>
                            <a href="/blog" class="view-all-link">View all posts &rarr;</a>
                    </section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.recent-posts {
		margin: 3rem 0;
	}
	.recent-posts h2 {
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
	}
	.footnote {
		display: inline-block;
		margin-top: 0.5rem;
		font-size: 0.85rem;                /* Makes it noticeably smaller */
		color: rgb(var(--gray));          /* Uses your theme's standard gray variable */
		opacity: 0.65;                    /* Grays it out slightly for that footnote look */
		font-style: italic;
		transition: opacity 0.2s ease;
	}

	/* Subtle interactive easter egg when they hover over the joke */
	.footnote:hover {
		opacity: 0.9;
	}
	/* 2-Column Responsive Grid Layout */
	.post-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		margin-bottom: 2rem;
	}
	@media (max-width: 600px) {
		.post-grid {
			grid-template-columns: 1fr; /* Stack vertically on small mobile screens */
		}
	}

	/* Card Elements */
	.post-card {
		display: flex;
		flex-direction: column;
		text-decoration: none !important;
		group: hover;
	}
	.image-wrapper {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 12px;
		background: rgba(var(--gray-light), 0.1);
		margin-bottom: 1rem;
	}
	/* 1. Update the base transition configuration */
	.image-wrapper img,
	.image-wrapper :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border: 0 !important;
		outline: none !important;
		transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
	}
	
	/* 2. Update the zoom depth rules */
	.post-card:hover img,
	.post-card:hover :global(img) {
		transform: scale(1.08); /* Deeper zoom factor */
	}
	.post-card:hover .post-title {
		color: var(--accent);
	}

	/* Content Typography */
	.card-content {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.post-title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		color: rgb(var(--gray-dark));
		transition: color 0.15s ease;
	}
	.post-date {
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}

	.view-all-link {
		display: inline-block;
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none !important;
	}
</style>
