---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
                        html,
                        body {
                                height: 100%;
                                margin: 0;
                        }

                        body {
                                display: flex;
                                flex-direction: column;
                                min-height: 100vh; /* Demands the page body spans at least the entire viewport window height */
                        }

                        main {
                                flex: 1 0 auto; /* Forces the middle content region to expand dynamically and consume all available empty vertical workspace */
                                width: 100%;
                                max-width: 720px;
                                margin: 0 auto;
                        }

                        footer {
                                flex-shrink: 0; /* Keeps the footer element locked down tight at the bottom plane */
                        }
			main {
				width: 100%;
				max-width: 720px; /* Aligns with header layout perfectly */
				margin: 0 auto;
				padding: clamp(1rem, 5vw, 2rem) clamp(1rem, 4vw, 1.5rem);
				box-sizing: border-box;
			}
			
			/* Fully Responsive Fluid Grid System */
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
				gap: clamp(1.25rem, 4vw, 2rem);
				list-style-type: none;
				margin: 0;
				padding: 0;
				width: 100%;
			}
			
			/* Keep first/featured item full width across columns */
			ul li {
				width: 100%;
			}
			ul li:first-child {
				grid-column: 1 / -1;
			}
			
			ul li a {
				display: flex;
				flex-direction: column;
				width: 100%;
				height: 100%;
				text-decoration: none !important;
				overflow: hidden;
			}
			
			/* Mask Container to hide expanding image edges */
			.image-container {
				width: 100%;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				border-radius: 12px;
				background: rgba(var(--gray-light), 0.1);
				margin-bottom: 0.75rem;
			}
			
			/* Targets standard images and Astro's optimized responsive images */
			.image-container img,
			.image-container :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border: 0 !important;
				outline: none !important;
				transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
			}

			/* Typography Layout Rules */
			.title {
				margin: 0 0 0.25rem 0;
				font-size: clamp(1.1rem, 3vw, 1.25rem);
				font-weight: 600;
				color: rgb(var(--gray-dark));
				line-height: 1.3;
				transition: color 0.15s ease;
				word-break: break-word;
			}
			.date {
				margin: 0;
				font-size: clamp(0.8rem, 2.5vw, 0.9rem);
				color: rgb(var(--gray));
				transition: color 0.15s ease;
			}

			/* Featured Post Text Scaling overrides */
			ul li:first-child .title {
				font-size: clamp(1.35rem, 5vw, 1.75rem);
			}

			/* Deep Hover Micro-Interactions */
			ul li a:hover img,
			ul li a:hover :global(img) {
				transform: scale(1.08); /* Deep zoom configuration */
			}
			ul li a:hover .title {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<div class="image-container">
											<Image 
												width={720} 
												height={360} 
												src={post.data.heroImage} 
												alt={`Cover image for ${post.data.title}`} 
												loading="lazy"
											/>
										</div>
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
