---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
    header {
		margin: 0;
		padding: 0 1rem;
		border-bottom: 1px solid rgba(var(--gray-light), 0.2);
	}
	nav {
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: center; /* Crucial fix: centers the entire link menu */
	}
	.internal-links {
		display: flex;
		gap: 2rem; /* Adds cleaner breathing room between options */
	}
	
	/* Style overrides for HeaderLink components */
	:global(nav a) {
		padding: 1rem 0;
		color: rgba(var(--gray-dark), 0.6) !important;
		text-decoration: none !important; /* Fixes default text underline */
		font-size: 0.95rem;
		border-bottom: 2px solid transparent;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	:global(nav a:hover) {
		color: var(--accent) !important;
	}
	:global(nav a.active) {
		color: rgb(var(--gray-dark)) !important;
		border-bottom-color: var(--accent); /* Clean single border line */
		text-decoration: none !important;
		font-weight: 500;
	}
</style>
